# URL publica del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://tueresmigasolina.com

# Nombre visible del canal
NEXT_PUBLIC_CHANNEL_NAME=Tueresmigasolina
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Tueresmigasolina

# Codigo necesario para publicar rutas desde /nueva
ADMIN_CODE=cambia-este-codigo

# Contacto para recibir propuestas de rutas ("Tu mandas")
NEXT_PUBLIC_CONTACT_EMAIL=tu-correo@ejemplo.com
# Numero de WhatsApp en formato internacional sin simbolos, ej: 34600123456
NEXT_PUBLIC_WHATSAPP=
# Canal de WhatsApp (para fans, sin exponer tu numero)
NEXT_PUBLIC_WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbECTyCGJP8BlsvjVk2m
# Webhook para recibir propuestas al instante (ntfy recomendado)
# Instala la app ntfy.sh y suscríbete a tu tema privado
PROPOSALS_WEBHOOK_URL=

# Slack: alertas de propuestas al movil (gratis, sin verificacion de negocio)
#   1. Crea un workspace gratis en https://slack.com
#   2. Ve a https://api.slack.com/apps -> Create App -> From scratch
#   3. Features -> Incoming Webhooks -> Activate -> Add New Webhook to Workspace
#   4. Copia la URL (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=

# Email: alertas de propuestas al movil
# Opcion A — Gmail directo (recomendado, gratis, sin intermediarios)
#   1. Activa la verificacion en 2 pasos en tu cuenta Google
#   2. Ve a https://myaccount.google.com/apppasswords
#   3. Crea una "contrasena de aplicacion" (16 caracteres) y pegala abajo
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Email donde recibes los avisos (tu Gmail). Si lo dejas vacio usa GMAIL_USER
NOTIFY_EMAIL=
NOTIFY_FROM_NAME=Tueresmigasolina

# Opcion B — Brevo (gratis 300/dia, sin tarjeta)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tueresmigasolina

# WhatsApp: alertas al movil cuando alguien propone una ruta (Tu mandas)
# Telefono destino en formato internacional sin "+" (ej: 34604442172)
WHATSAPP_PHONE=
# Meta WhatsApp Cloud API (oficial, recomendado, gratis hasta 1000 conv/mes):
#   1. https://developers.facebook.com -> crear app -> agregar producto WhatsApp
#   2. En WhatsApp > API Setup copia el "Phone number ID"
#   3. Genera un token permanente (System User) con whatsapp_business_messaging
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
# WhatsAble (alternativa): crea cuenta en https://dashboard.whatsable.app
WHATSABLE_API_KEY=
# CallMeBot (alternativa gratuita si el bot tiene plazas libres):
#   guarda el bot en contactos y enviale: I allow callmebot to send me messages
WHATSAPP_CALLMEBOT_PHONE=
WHATSAPP_CALLMEBOT_APIKEY=

# Supabase (opcional). Si no se define, se usa almacenamiento local en .data/routes.json
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
